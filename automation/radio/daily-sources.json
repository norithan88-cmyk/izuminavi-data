    "groundingSupports": [
      {
        "segment": {
          "startIndex": 566,
          "endIndex": 683,
          "text": "蒲郡市は北を山に囲まれ、南は三河湾に面した温暖な南向きの扇状地に位置しています"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 686,
          "endIndex": 773,
          "text": "日照時間が長く、海からの暖かい潮風が吹き込む絶好の立地です"
        },
        "groundingChunkIndices": [
          2,
          0
        ]
      },
      {
        "segment": {
          "startIndex": 776,
          "endIndex": 848,
          "text": "さらに甘さを凝縮させる決め手が「マルチ栽培」です"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 851,
          "endIndex": 1064,
          "text": "みかんの木の下の地面を白い透水性・反射性シートで覆うことで、余分な雨水が入るのを防ぎ、木に適度な水分ストレスを与えて糖度をギュッと濃縮させます"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 1067,
          "endIndex": 1178,
          "text": "同時に、白いシートが太陽光を下からも反射させて果実全体をくまなく熟させます"
        },
        "groundingChunkIndices": [
          2,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 1220,
          "endIndex": 1397,
          "text": "「蒲郡みかん」は2008年（平成20年）に愛知県内の農産物として初めて特許庁の「地域団体商標（地域ブランド）」に認定されました"
        },
        "groundingChunkIndices": [
          0,
          3
        ]
      },
      {
        "segment": {
          "startIndex": 1400,
          "endIndex": 1573,
          "text": "愛知県のみかん収穫量は年間約19,600トン（全国7位）を誇り、特に温室みかんの生産量は佐賀県に次ぐ全国第2位の実績を持ちます"
        },
        "groundingChunkIndices": [
          0,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 1600,
          "endIndex": 1816,
          "text": "晩秋のみかん畑を山側から眺めると、まるで雪が積もったかのように地面一面が真っ白に見えますが、これは雪ではなく農家が敷き詰めた「マルチシート」です"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1819,
          "endIndex": 2017,
          "text": "植物に水をたっぷり与えるのではなく、あえて「喉が渇いた状態（水分制限）」に追い込むことで、あの強い甘みと深いコクが生み出されています"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 2047,
          "endIndex": 2277,
          "text": "蒲郡でのみかん作りの歴史は非常に古く、江戸時代初期の延宝7年（1679年）の五井村（現・蒲郡市五井町）の検地帳「田畑新切帳」に数本のみかんの木が記録されています"
        },
        "groundingChunkIndices": [
          5,
          3
        ]
      },
      {
        "segment": {
          "startIndex": 2280,
          "endIndex": 2376,
          "text": "300年以上前の江戸時代から連綿と受け継がれてきた伝統の果樹園地です"
        },
        "groundingChunkIndices": [
          3
        ]
      },
      {
        "segment": {
          "startIndex": 2406,
          "endIndex": 2465,
          "text": "JA蒲郡市公式ホームページ「みかん豆知識」"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 2406,
          "endIndex": 2555,
          "text": "JA蒲郡市公式ホームページ「みかん豆知識」、蒲郡市観光協会公式サイト「がまごおり、ナビ（蒲郡みかん）」"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 2406,
          "endIndex": 2625,
          "text": "JA蒲郡市公式ホームページ「みかん豆知識」、蒲郡市観光協会公式サイト「がまごおり、ナビ（蒲郡みかん）」、蒲郡市博物館「蒲郡の歴史と文化財 蒲郡みかん」"
        },
        "groundingChunkIndices": [
          3
        ]
      },
      {
        "segment": {
          "startIndex": 2406,
          "endIndex": 2691,
          "text": "JA蒲郡市公式ホームページ「みかん豆知識」、蒲郡市観光協会公式サイト「がまごおり、ナビ（蒲郡みかん）」、蒲郡市博物館「蒲郡の歴史と文化財 蒲郡みかん」、愛知県農林水産部「あいちの農産物（果物）」"
        },
        "groundingChunkIndices": [
          4
        ]
      },
      {
        "segment": {
          "startIndex": 2931,
          "endIndex": 3189,
          "text": "紅葉で知られる香嵐渓のすぐ隣にある足助の町並み（重伝建地区）は、かつて三河湾で作られた塩を信州（長野・塩尻方面）へ運ぶ街道「中馬街道（伊那街道）」の最大の物流中継拠点でした"
        },
        "groundingChunkIndices": [
          6,
          7,
          8
        ]
      },
      {
        "segment": {
          "startIndex": 3192,
          "endIndex": 3360,
          "text": "矢作川や巴川を船で遡ってきた大量の塩は、ここ足助で陸揚げされ、山越えをする馬（中馬）の背に積み替えて運ばれました"
        },
        "groundingChunkIndices": [
          9,
          6,
          7
        ]
      },
      {
        "segment": {
          "startIndex": 3402,
          "endIndex": 3676,
          "text": "各地の塩田（三河湾沿いの吉良・饗庭塩や一色塩、知多の成岩塩、瀬戸内海の西国塩など）から届く塩俵は、1俵あたり4貫目（約15kg）や6貫目（約22.5kg）など産地によって重さや粒の粗さがバラバラでした"
        },
        "groundingChunkIndices": [
          6
        ]
      },
      {
        "segment": {
          "startIndex": 3679,
          "endIndex": 3895,
          "text": "足助の塩問屋（塩座）では、塩を踏んで均一に混ぜ合わせ、険しい山道を馬1頭が左右均等に背負いやすいよう「7貫目（約26kg）」の俵にぴったり包み直しました"
        },
        "groundingChunkIndices": [
          10,
          6
        ]
      },
      {
        "segment": {
          "startIndex": 3898,
          "endIndex": 4017,
          "text": "この作業を「塩直し（足助直し）」と呼び、町には13軒もの塩問屋が立ち並んでいました"
        },
        "groundingChunkIndices": [
          10,
          6,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4044,
          "endIndex": 4137,
          "text": "足助は単なる荷物の積み替え場所ではなく、塩のブレンド工場でした"
        },
        "groundingChunkIndices": [
          10,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4140,
          "endIndex": 4380,
          "text": "瀬戸内海の塩と三河の塩を絶妙に調合してにがり分を調整した「足助直し」は、味がまろやかでおむすびや漬物によく合う高級ブランド塩として信州側で絶大な信頼を集めました"
        },
        "groundingChunkIndices": [
          10,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4410,
          "endIndex": 4779,
          "text": "忠臣蔵（赤穂事件）では吉良上野介（三河・吉良塩の領主）と浅野内匠頭（播磨・赤穂塩の領主）が犬猿の仲として知られますが、ここ足助の塩座では、吉良の塩と赤穂の塩が仲良く一緒に混ぜ合わされ（ブレンドされ）、美味しい合わせ塩となって信州へ旅立っていました"
        },
        "groundingChunkIndices": [
          12,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4809,
          "endIndex": 4889,
          "text": "豊田市博物館 展示ガイド「信州まで続く塩の道 足助直し」"
        },
        "groundingChunkIndices": [
          13
        ]
      },
      {
        "segment": {
          "startIndex": 4809,
          "endIndex": 4961,
          "text": "豊田市博物館 展示ガイド「信州まで続く塩の道 足助直し」、国土交通省中部地方整備局「塩の道～中馬街道～」"
        },
        "groundingChunkIndices": [
          9
        ]
      },
      {
        "segment": {
          "startIndex": 4809,
          "endIndex": 5028,
          "text": "豊田市博物館 展示ガイド「信州まで続く塩の道 足助直し」、国土交通省中部地方整備局「塩の道～中馬街道～」、豊田市足助観光協会「莨屋 塩座（足助直し）」"
        },
        "groundingChunkIndices": [
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4809,
          "endIndex": 5106,
          "text": "豊田市博物館 展示ガイド「信州まで続く塩の道 足助直し」、国土交通省中部地方整備局「塩の道～中馬街道～」、豊田市足助観光協会「莨屋 塩座（足助直し）」、豊田市観光協会公式ツーリズムとよた「足助の町並み」"
        },
        "groundingChunkIndices": [
          8
        ]
      },
      {
        "segment": {
          "startIndex": 5304,
          "endIndex": 5418,
          "text": "タコ壺漁の壺にはフタも返し（返し弁）もついておらず、口がぽっかり開いています"
        },
        "groundingChunkIndices": [
          14,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 5421,
          "endIndex": 5538,
          "text": "逃げ出さない理由は「出られない」のではなく、タコが「自ら出たがらない」からです"
        },
        "groundingChunkIndices": [
          14
        ]
      },
      {
        "segment": {
          "startIndex": 5541,
          "endIndex": 5745,
          "text": "タコは骨がない軟体動物のため外敵に狙われやすく、暗くて狭い岩穴に体が密着している状態に強い安心感を覚える習性（正の走触性）を持っています"
        },
        "groundingChunkIndices": [
          14,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 5748,
          "endIndex": 5964,
          "text": "壺の中にぴったりとおさまり落ち着いてしまっているため、海中からロープで引き揚げられる間も、外に泳ぎ出るどころか奥へ奥へと踏ん張って居座り続けます"
        },
        "groundingChunkIndices": [
          14
        ]
      },
      {
        "segment": {
          "startIndex": 6006,
          "endIndex": 6182,
          "text": "日本のタコ壺漁の歴史は弥生時代（約2,000年以上前）にまで遡り、各地の遺跡から素焼きのタコ壺（蛸壺形土器）が出土しています"
        },
        "groundingChunkIndices": [
          16
        ]
      },
      {
        "segment": {
          "startIndex": 6185,
          "endIndex": 6392,
          "text": "底引き網漁などに比べてタコの体に傷がつかず、ストレスが少ない状態で生きたまま水揚げできるため、市場でも高値で取引される極上のタコになります"
        },
        "groundingChunkIndices": [
          16,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6419,
          "endIndex": 6581,
          "text": "タコ壺は獲物を無理やり閉じ込める「罠」というより、タコにとっては「最高の隠れ家（無料の個室マンション）」です"
        },
        "groundingChunkIndices": [
          16
        ]
      },
      {
        "segment": {
          "startIndex": 6584,
          "endIndex": 6749,
          "text": "エサで誘い込む必要すらなく、壺を沈めておくだけで、夜の食事を終えたタコが朝方に自分から好んで入って眠り込みます"
        },
        "groundingChunkIndices": [
          17,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 6779,
          "endIndex": 6959,
          "text": "現在のタコ壺は軽くて丈夫なプラスチック製も使われますが、日間賀島などでは伝統的な陶器・素焼きの壺も長く愛用されてきました"
        },
        "groundingChunkIndices": [
          16,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6962,
          "endIndex": 7174,
          "text": "弥生時代の素焼き土器と現代のタコ壺を見比べると、驚くほど形やサイズが変わっておらず、約2,000年前の漁師の観察眼が現代までそのまま生き続けています"
        },
        "groundingChunkIndices": [
          16
        ]
      },
      {
        "segment": {
          "startIndex": 7204,
          "endIndex": 7252,
          "text": "四国水族館「展示解説：蛸壷の景」"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 7347,
          "endIndex": 7377,
          "text": "日間賀島のタコ漁）」"
        },
        "groundingChunkIndices": [
          18
        ]
      },
      {
        "segment": {
          "startIndex": 7347,
          "endIndex": 7413,
          "text": "日間賀島のタコ漁）」、水族館用語辞典「蛸壺」"
        },
        "groundingChunkIndices": [
          17
        ]
      },
      {
        "segment": {
          "startIndex": 7635,
          "endIndex": 7782,
          "text": "愛知県瀬戸市は、平安時代から灰釉を使った本格的な施釉陶器を日本で唯一焼き続けてきた歴史ある窯場です"
        },
        "groundingChunkIndices": [
          19
        ]
      },
      {
        "segment": {
          "startIndex": 7785,
          "endIndex": 7998,
          "text": "東日本を中心に陶磁器全般を「せともの」と呼ぶようになったのは、瀬戸が日用の食器から美術品まで圧倒的な流通量を誇り、全国の食卓へ普及したためです"
        },
        "groundingChunkIndices": [
          19,
          20
        ]
      },
      {
        "segment": {
          "startIndex": 8040,
          "endIndex": 8271,
          "text": "江戸時代初期、九州で白いガラス質の「磁器（有田焼など）」が開発されると、旧来の陶器（土もの）しか作れなかった瀬戸焼は人気を奪われ、壊滅的な不況に陥りました"
        },
        "groundingChunkIndices": [
          19,
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 8274,
          "endIndex": 8571,
          "text": "有田から遅れること約200年、瀬戸の陶工・加藤民吉が九州から門外不出の磁器技術を持ち帰ったことで瀬戸でも磁器生産が爆発的に広がり、陶器と磁器の両方を大量生産する世界屈指のやきもの産地へ大復活を遂げました"
        },
        "groundingChunkIndices": [
          23,
          22,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 8574,
          "endIndex": 8757,
          "text": "西日本では唐津焼に由来してやきものを「からつもの」と呼ぶ地域もありますが、東日本では「せともの」が代名詞として定着しました"
        },
        "groundingChunkIndices": [
          19
        ]
      },
      {
        "segment": {
          "startIndex": 8784,
          "endIndex": 9186,
          "text": "一般的な産地は「陶器（土もの）」か「磁器（石もの）」のどちらか一方に偏ることが多いのに対し、瀬戸地域は良質な陶土（蛙目粘土など）と、花崗岩が風化してできた磁器の原料土（サバ土）の両方が同じ地層（瀬戸層群）から採れるという、世界でも極めて珍しい恵まれた大地を持っています"
        },
        "groundingChunkIndices": [
          25,
          20
        ]
      },
      {
        "segment": {
          "startIndex": 9216,
          "endIndex": 9351,
          "text": "瀬戸の磁器の祖として神様（窯神神社）に祀られている加藤民吉ですが、実は「窯屋の次男」でした"
        },
        "groundingChunkIndices": [
          26,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 9354,
          "endIndex": 9573,
          "text": "当時の掟で家業を継ぐことができず、名古屋の熱田新田の開発現場で土木工事に従事していたところ、熱田奉行の津金文左衛門に才能を見出されて磁器研究を開始"
        },
        "groundingChunkIndices": [
          26,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 9576,
          "endIndex": 9720,
          "text": "その後、藩と地域の期待を背負って九州へ旅立ち、苦難の末に技法を習得して瀬戸を救う英雄となりました"
        },
        "groundingChunkIndices": [
          26,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 9750,
          "endIndex": 9813,
          "text": "瀬戸陶磁器卸商業協同組合「せとものの歴史」"
        },
        "groundingChunkIndices": [
          19
        ]
      },
      {
        "segment": {
          "startIndex": 9750,
          "endIndex": 9873,
          "text": "瀬戸陶磁器卸商業協同組合「せとものの歴史」、瀬戸市公式ホームページ「民吉について」"
        },
        "groundingChunkIndices": [
          26
        ]
      },
      {
        "segment": {
          "startIndex": 9750,
          "endIndex": 9966,
          "text": "瀬戸陶磁器卸商業協同組合「せとものの歴史」、瀬戸市公式ホームページ「民吉について」、瀬戸市歴史文化基本構想「加藤民吉・磁祖民吉屋敷跡・民吉墓碑」"
        },
        "groundingChunkIndices": [
          24
        ]
      },
      {
        "segment": {
          "startIndex": 9750,
          "endIndex": 10023,
          "text": "瀬戸陶磁器卸商業協同組合「せとものの歴史」、瀬戸市公式ホームページ「民吉について」、瀬戸市歴史文化基本構想「加藤民吉・磁祖民吉屋敷跡・民吉墓碑」、瀬戸市文化振興財団「瀬戸染付の全貌」"
        },
        "groundingChunkIndices": [
          22
        ]
      },
      {
        "segment": {
          "startIndex": 10894,
          "endIndex": 10999,
          "text": "タコには、狭くて暗い隙間に体がピタッと密着すると落ち着く習性があります"
        },
        "groundingChunkIndices": [
          14,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 11002,
          "endIndex": 11101,
          "text": "タコ壺は獲物を閉じ込める檻ではなく、タコにとっては「最高の隠れ家」"
        },
        "groundingChunkIndices": [
          16
        ]
      },
      {
        "segment": {
          "startIndex": 11104,
          "endIndex": 11251,
          "text": "海から引き揚げられるときも、壺の奥でぎゅっと踏ん張って居座っているためフタがなくても逃げないのです"
        },
        "groundingChunkIndices": [
          14
        ]
      },
      {
        "segment": {
          "startIndex": 11254,
          "endIndex": 11352,
          "text": "弥生時代から2,000年以上変わらない、タコの心理を突いた伝統の知恵です"
        },
        "groundingChunkIndices": [
          16
        ]
      }
    ],
