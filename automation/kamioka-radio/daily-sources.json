    "groundingSupports": [
      {
        "segment": {
          "startIndex": 769,
          "endIndex": 994,
          "text": "語源には諸説ありますが、神岡町の老舗飲食店などによると、かつて朝鮮半島でホルモン・内臓全般を指していた言葉（トンチャン等）に由来するという説が有力です"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 997,
          "endIndex": 1201,
          "text": "一般的な東海地方の「とんちゃん」は豚の腸を指すことが多いのに対し、神岡では上質な牛の内臓を鉄板で焼く独自の料理としてその名が定着しました"
        },
        "groundingChunkIndices": [
          0,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1243,
          "endIndex": 1465,
          "text": "飛騨市や観光協会の資料によると、神岡とんちゃんではミノ、センマイ、ハチノス、小腸など、約8〜10種類もの様々な部位の牛ホルモンがミックスされて使われます"
        },
        "groundingChunkIndices": [
          0,
          3,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 1468,
          "endIndex": 1561,
          "text": "豚ホルモン単体に比べて多彩な食感とうま味を楽しめるのが特徴です"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 1588,
          "endIndex": 1769,
          "text": "通常ホルモン焼きといえば肉を食べるのが主役ですが、神岡とんちゃんは「野菜と肉汁の調和」、そして「2段階のシメ」が真骨頂です"
        },
        "groundingChunkIndices": [
          0,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 1772,
          "endIndex": 1976,
          "text": "鉄板に残った秘伝の味噌ダレに、まず「うどん」を投入して楽しみ、さらにその後に「ご飯」を絡めて食べるという独自の食文化が受け継がれています"
        },
        "groundingChunkIndices": [
          0,
          3,
          1,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 2006,
          "endIndex": 2113,
          "text": "誕生は昭和30年代、東洋一の亜鉛山として栄えていた神岡鉱山の時代に遡ります"
        },
        "groundingChunkIndices": [
          0,
          5,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 2116,
          "endIndex": 2416,
          "text": "過酷な坑内作業を終えた鉱山労働者たちが、手早くスタミナをつけて英気を養えるよう、味噌やニンニクを効かせたタレで味付けしたホルモンをキャベツや玉ねぎと一緒に平鍋・鉄板で豪快に炒めたのが発祥とされています"
        },
        "groundingChunkIndices": [
          0,
          5,
          3
        ]
      },
      {
        "segment": {
          "startIndex": 2451,
          "endIndex": 2526,
          "text": "飛騨市公式ウェブサイト「きのえ（神岡とんちゃん）」"
        },
        "groundingChunkIndices": [
          3
        ]
      },
      {
        "segment": {
          "startIndex": 2531,
          "endIndex": 2597,
          "text": "飛騨市公式観光サイト「飛騨の旅」（たからや）"
        },
        "groundingChunkIndices": [
          6
        ]
      },
      {
        "segment": {
          "startIndex": 2602,
          "endIndex": 2686,
          "text": "岐阜県観光公式サイト「岐阜の旅ガイド」（神岡とんちゃん）"
        },
        "groundingChunkIndices": [
          5
        ]
      },
      {
        "segment": {
          "startIndex": 2834,
          "endIndex": 3026,
          "text": "岐阜県（岐阜市・各務原市など）や愛知県の木曽川・長良川流域で栽培される「守口大根」は、ギネス記録にも認定される世界一長い大根です"
        },
        "groundingChunkIndices": [
          7,
          8,
          9,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 3110,
          "endIndex": 3305,
          "text": "品種特有の旺盛な伸長力に加え、栽培地である長良川や木曽川の河畔に「きめ細かく深くまで均質で柔らかい砂質土壌」が広がっているためです"
        },
        "groundingChunkIndices": [
          11,
          12,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 3308,
          "endIndex": 3549,
          "text": "土中に小石や粘土層などの障害物があると根が二股に分かれたり曲がったりしてしまいますが、障害物のない深い砂地だからこそ、地下深くへ真っ直ぐ1本に伸びることができます"
        },
        "groundingChunkIndices": [
          11,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 3591,
          "endIndex": 3832,
          "text": "普段家庭で食べる一般的な青首大根は長さ約30cm・太さ約8cm前後ですが、守口大根は直径がわずか2〜3cmほどしかないのに対し、長さは平均1.2〜1.3m、長いものでは1.8m以上に達します"
        },
        "groundingChunkIndices": [
          11,
          9,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 3835,
          "endIndex": 3990,
          "text": "2013年には愛知県扶桑町で収穫された191.7cmの守口大根が「世界一長い大根」としてギネス世界記録に登録されました"
        },
        "groundingChunkIndices": [
          9
        ]
      },
      {
        "segment": {
          "startIndex": 4017,
          "endIndex": 4197,
          "text": "「守口」という大阪の地名がついているのに、現在の全国シェアのほとんどは木曽川・長良川流域（岐阜県・愛知県）が占めています"
        },
        "groundingChunkIndices": [
          11,
          7,
          10,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 4200,
          "endIndex": 4447,
          "text": "また、身が非常に硬く締まっていて辛みが強いため、煮物やサラダなどの生食には向かず、3年近くかけて塩や酒粕・みりん粕に漬け込む「守口漬」専用の野菜として栽培されています"
        },
        "groundingChunkIndices": [
          10,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 4477,
          "endIndex": 4699,
          "text": "起源は室町時代の大阪・淀川流域（現在の守口市付近）とされ、天正年間に豊臣秀吉がこの大根の粕漬けを食して絶賛し「守口漬」と命名したという逸話があります"
        },
        "groundingChunkIndices": [
          11,
          14
        ]
      },
      {
        "segment": {
          "startIndex": 4702,
          "endIndex": 4834,
          "text": "しかし明治以降、淀川の改修工事や都市化によって本家・大阪の産地はほぼ消滅してしまいました"
        },
        "groundingChunkIndices": [
          11,
          14,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 4837,
          "endIndex": 5056,
          "text": "淀川と地質条件がそっくりだった木曽川・長良川流域の農家が栽培技術を受け継ぎ、東海地方を代表する特産品として生き残ったという数奇な歴史を持っています"
        },
        "groundingChunkIndices": [
          7,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 5091,
          "endIndex": 5154,
          "text": "農林水産省「にっぽん伝統食図鑑」（守口漬）"
        },
        "groundingChunkIndices": [
          11
        ]
      },
      {
        "segment": {
          "startIndex": 5159,
          "endIndex": 5235,
          "text": "環境省「中部生物多様性物語Ⅱ 絶滅から生まれた名物」"
        },
        "groundingChunkIndices": [
          7
        ]
      },
      {
        "segment": {
          "startIndex": 5240,
          "endIndex": 5318,
          "text": "愛知県農業水産局「あいちの伝統野菜（守口だいこん）」"
        },
        "groundingChunkIndices": [
          9
        ]
      },
      {
        "segment": {
          "startIndex": 5323,
          "endIndex": 5380,
          "text": "岐阜県「ぎふの農産物（守口だいこん）」"
        },
        "groundingChunkIndices": [
          12
        ]
      },
      {
        "segment": {
          "startIndex": 5545,
          "endIndex": 5726,
          "text": "傷みやすい「生卵」を原料に使っているマヨネーズですが、未開封であれば冷蔵庫に入れず、キッチンの常温で約1年間も保存できます"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 5786,
          "endIndex": 5960,
          "text": "マヨネーズには「食塩」と、殺菌力を持つ「醸造酢」が含まれており、製品全体が強い酸性（pH約4前後）に保たれているためです"
        },
        "groundingChunkIndices": [
          16,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 5963,
          "endIndex": 6183,
          "text": "さらに、成分の約7割を占める植物油の微粒子が水分を包み込む乳化構造をとっており、細菌が増殖するために必要な「自由水」が極めて少ない環境になっています"
        },
        "groundingChunkIndices": [
          18,
          15,
          19
        ]
      },
      {
        "segment": {
          "startIndex": 6225,
          "endIndex": 6401,
          "text": "通常の生卵の賞味期限は生食で約2週間程度ですが、キユーピーのマヨネーズ（未開封）の賞味期間は12〜13カ月に設定されています"
        },
        "groundingChunkIndices": [
          18,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6404,
          "endIndex": 6616,
          "text": "キユーピーの実験データによると、マヨネーズの中に病原菌を試験的に添加しても、酢と食塩の殺菌作用により24時間以内に全滅することが確認されています"
        },
        "groundingChunkIndices": [
          17
        ]
      },
      {
        "segment": {
          "startIndex": 6643,
          "endIndex": 6769,
          "text": "これほど長持ちするにもかかわらず、合成保存料や防腐剤は一切使われていません（無添加）"
        },
        "groundingChunkIndices": [
          20
        ]
      },
      {
        "segment": {
          "startIndex": 6772,
          "endIndex": 6862,
          "text": "また、未開封の段階では「冷蔵庫に入れない」ほうが長持ちします"
        },
        "groundingChunkIndices": [
          17
        ]
      },
      {
        "segment": {
          "startIndex": 6865,
          "endIndex": 7151,
          "text": "マヨネーズは0℃以下になると油と酢の乳化が破壊されて分離し、防腐効果が損なわれるため、メーカーは開栓前は常温の冷暗所、開栓後も冷気の直撃を避けて冷蔵室のドアポケット付近での保存を推奨しています"
        },
        "groundingChunkIndices": [
          17
        ]
      },
      {
        "segment": {
          "startIndex": 7181,
          "endIndex": 7328,
          "text": "1925年（大正14年）に日本で初めてマヨネーズを製造・販売したキユーピーの歴史は、「酸素との戦い」でした"
        },
        "groundingChunkIndices": [
          18
        ]
      },
      {
        "segment": {
          "startIndex": 7331,
          "endIndex": 7412,
          "text": "マヨネーズが傷む主な原因は腐敗ではなく「油の酸化」です"
        },
        "groundingChunkIndices": [
          18,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 7415,
          "endIndex": 7703,
          "text": "そのため、酸素を通しにくい多層プラスチックボトル、ボトルの口に貼るアルミシール、容器内に残った空気を窒素に置き換える技術など、容器包装の改良を何十年も重ねて賞味期限を伸ばしてきた経緯があります"
        },
        "groundingChunkIndices": [
          18,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 7838,
          "endIndex": 7868,
          "text": "おいしさを保つ工夫」"
        },
        "groundingChunkIndices": [
          17
        ]
      },
      {
        "segment": {
          "startIndex": 7873,
          "endIndex": 7955,
          "text": "キユーピー株式会社 食育活動「酢と食塩の力で長持ちする」"
        },
        "groundingChunkIndices": [
          16
        ]
      },
      {
        "segment": {
          "startIndex": 8294,
          "endIndex": 8641,
          "text": "タマネギの細胞が包丁で傷つくと、細胞内に別々に保管されていた含硫アミノ酸（PRENCSO）と酵素「アリイナーゼ」が混ざり合い、さらに「催涙因子合成酵素（LFS）」が働くことで、揮発性の催涙成分（syn-プロパンチアール-S-オキシド）が生成されるためです"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 8644,
          "endIndex": 8758,
          "text": "この気体が空気中を漂って目の角膜に触れ、神経を刺激することで涙が分泌されます"
        },
        "groundingChunkIndices": [
          23,
          22,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 9262,
          "endIndex": 9407,
          "text": "かつて世界の科学界では「アリイナーゼという1つの酵素が催涙成分を作る」と数十年間信じられていました"
        },
        "groundingChunkIndices": [
          25,
          26
        ]
      },
      {
        "segment": {
          "startIndex": 9410,
          "endIndex": 9700,
          "text": "しかし、日本のハウス食品の研究グループが「実は催涙成分を作るには、もう1つの未知の酵素（催涙因子合成酵素：LFS）が必要不可欠である」ことを突き止め、2002年に世界的科学雑誌『Nature』に論文を発表しました"
        },
        "groundingChunkIndices": [
          21,
          27,
          28
        ]
      },
      {
        "segment": {
          "startIndex": 9703,
          "endIndex": 9878,
          "text": "この功績により、同研究チームは2013年に「人々を笑わせ、考えさせる」研究に贈られる「イグノーベル化学賞」を受賞しています"
        },
        "groundingChunkIndices": [
          21,
          28,
          25
        ]
      },
      {
        "segment": {
          "startIndex": 9908,
          "endIndex": 10154,
          "text": "この世界的な大発見のきっかけは、同社がレトルトカレーの開発中、「タマネギとニンニクを一緒に炒めると、なぜか全体が緑色に変色してしまう」という製造現場のトラブルでした"
        },
        "groundingChunkIndices": [
          27,
          28,
          25
        ]
      },
      {
        "segment": {
          "startIndex": 10157,
          "endIndex": 10392,
          "text": "なぜ緑色になるのかという失敗原因を追究する基礎研究の中で、偶然にもタマネギに隠されていた第2の酵素が見つかったという、まさに失敗から生まれた世紀の大発見でした"
        },
        "groundingChunkIndices": [
          27,
          28,
          25
        ]
      },
      {
        "segment": {
          "startIndex": 10427,
          "endIndex": 10557,
          "text": "ハウス食品グループ本社「タマネギ研究での イグノーベル賞受賞について（プレスリリース）」"
        },
        "groundingChunkIndices": [
          21
        ]
      },
      {
        "segment": {
          "startIndex": 10562,
          "endIndex": 10646,
          "text": "ハウス食品グループ本社「タマネギの催涙成分に関する研究」"
        },
        "groundingChunkIndices": [
          27
        ]
      },
      {
        "segment": {
          "startIndex": 10651,
          "endIndex": 10741,
          "text": "日本植物生理学会「みんなのひろば：玉ねぎの催涙成分について」"
        },
        "groundingChunkIndices": [
          22
        ]
      },
      {
        "segment": {
          "startIndex": 10828,
          "endIndex": 10933,
          "text": "飛騨市神岡町で半世紀以上愛されている名物ソウルフード「神岡とんちゃん」"
        },
        "groundingChunkIndices": [
          0,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 11180,
          "endIndex": 11215,
          "text": "**② 牛肉（牛ホルモン）**"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 11254,
          "endIndex": 11470,
          "text": "名前に「豚（とん）」と入っているため豚肉と思われがちですが、神岡とんちゃんは国産牛の小腸やミノ、センマイなどの牛ホルモンを使うのが大きな特徴です"
        },
        "groundingChunkIndices": [
          0,
          3,
          29
        ]
      },
      {
        "segment": {
          "startIndex": 11476,
          "endIndex": 11676,
          "text": "とん」は朝鮮半島の言葉で内臓を意味していた言葉に由来するという説があり、昭和30年代に神岡鉱山で働く方々のスタミナ料理として定着しました"
        },
        "groundingChunkIndices": [
          0,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 11679,
          "endIndex": 11836,
          "text": "野菜と一緒に鉄板で炒めたあと、タレにうどん、さらにご飯を投入してシメを2度味わうのが神岡流の粋な食べ方です"
        },
        "groundingChunkIndices": [
          0,
          3,
          4
        ]
      }
    ],
