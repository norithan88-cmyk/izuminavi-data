    "groundingSupports": [
      {
        "segment": {
          "startIndex": 892,
          "endIndex": 1237,
          "text": "もともと高山市丹生川町（旧丹生川村）で代々自家用として種を継いできた在来品種（固定種）であり、品種改良によって丸く均一に整えられた現代の西洋カボチャと異なり、古くから伝わる固有の遺伝的特徴（細長い果形）をそのまま残しているためです"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 1279,
          "endIndex": 1489,
          "text": "一般的な黒皮栗カボチャが直径15〜20cm程度の扁平な球形（重さ1.5〜2kg）であるのに対し、宿儺かぼちゃは長さ**約50cm〜80cm**、重さ**約2.5kg〜5kg**にも達します"
        },
        "groundingChunkIndices": [
          0,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1492,
          "endIndex": 1669,
          "text": "成分面でも、他のかぼちゃと比べて糖質の一種である「スクロース（ショ糖）」が多く含まれ、細胞壁が薄いという特徴があります"
        },
        "groundingChunkIndices": [
          1
        ]
      },
      {
        "segment": {
          "startIndex": 1672,
          "endIndex": 1783,
          "text": "そのため、加熱するとキメが細かく、栗のようにホクホクとした強い甘みが出ます"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 1984,
          "endIndex": 2149,
          "text": "また、かつては門外不出の「自家用野菜」として農家の庭先だけで消費されており、市場には一切出回っていませんでした"
        },
        "groundingChunkIndices": [
          0,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 2179,
          "endIndex": 2315,
          "text": "現在の「宿儺かぼちゃ」という名前がついたのは、実は比較的最近の**2001年（平成13年）**のことです"
        },
        "groundingChunkIndices": [
          0,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 2318,
          "endIndex": 2648,
          "text": "特産品化にあたり当初は「長かぼちゃ」「ひょうたんかぼちゃ」といった案も出ましたが、飛騨を拓いたとされる丹生川ゆかりの古代の英雄「両面宿儺（りょうめんすくな）」のように地域で長く親しまれてほしいという願いから命名されました"
        },
        "groundingChunkIndices": [
          0,
          1,
          3
        ]
      },
      {
        "segment": {
          "startIndex": 2678,
          "endIndex": 2769,
          "text": "岐阜県公式ウェブサイト「飛騨伝統野菜と特産野菜 宿儺かぼちゃ」"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 2678,
          "endIndex": 2826,
          "text": "岐阜県公式ウェブサイト「飛騨伝統野菜と特産野菜 宿儺かぼちゃ」、岐阜県観光公式サイト「宿儺かぼちゃ」"
        },
        "groundingChunkIndices": [
          1
        ]
      },
      {
        "segment": {
          "startIndex": 3241,
          "endIndex": 3331,
          "text": "新雪が「天然の吸音材」として周囲の音を吸収してしまうためです"
        },
        "groundingChunkIndices": [
          4
        ]
      },
      {
        "segment": {
          "startIndex": 3334,
          "endIndex": 3451,
          "text": "雪の結晶が互いに絡み合いながら積もると、無数の微細な隙間（空気層）が生まれます"
        },
        "groundingChunkIndices": [
          5,
          6
        ]
      },
      {
        "segment": {
          "startIndex": 3454,
          "endIndex": 3655,
          "text": "音（空気の振動）がその隙間に入り込むと、微細な空気層が激しく振動して摩擦が起き、音エネルギーが熱エネルギーへと変換されて音が減衰します"
        },
        "groundingChunkIndices": [
          5,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 3697,
          "endIndex": 3904,
          "text": "固まった氷の密度は1リットルあたり約0.9kgですが、降り積もったばかりの新雪は密度がその約10分の1（体積あたりの空気の割合が**90％以上**）に達します"
        },
        "groundingChunkIndices": [
          4
        ]
      },
      {
        "segment": {
          "startIndex": 3907,
          "endIndex": 4075,
          "text": "この多孔質構造は、音楽室や録音スタジオの壁に貼る「グラスウール吸音材」や多孔質吸音パネルとまったく同じ仕組みです"
        },
        "groundingChunkIndices": [
          4,
          7
        ]
      },
      {
        "segment": {
          "startIndex": 4078,
          "endIndex": 4192,
          "text": "特に人の声や生活騒音に含まれる高音域の音ほど吸収されやすい性質を持っています"
        },
        "groundingChunkIndices": [
          5
        ]
      },
      {
        "segment": {
          "startIndex": 4282,
          "endIndex": 4435,
          "text": "吸音効果が最も高いのは、結晶の隙間が多い「ふわふわの新雪」や比較的気温が高いときに降る「ぼたん雪」です"
        },
        "groundingChunkIndices": [
          6
        ]
      },
      {
        "segment": {
          "startIndex": 4438,
          "endIndex": 4645,
          "text": "時間が経って踏み固められた圧雪や凍りついたアイスバーンになると、空気の隙間が潰れるため吸音効果は失われ、逆に音を硬く反射するようになります"
        },
        "groundingChunkIndices": [
          4
        ]
      },
      {
        "segment": {
          "startIndex": 4684,
          "endIndex": 4942,
          "text": "世界で初めて人工雪の作製に成功した中谷宇吉郎の研究をはじめ、日本建築学会の『雪と建築』や各大学の音響実験でも、昔から「積雪による音響減衰」が科学的に計測・実証されてきました"
        },
        "groundingChunkIndices": [
          5,
          6
        ]
      },
      {
        "segment": {
          "startIndex": 4945,
          "endIndex": 5068,
          "text": "雪国で感じる「静寂」は、単なる寒さによる心理的な錯覚ではなく、物理的な音響現象です"
        },
        "groundingChunkIndices": [
          8,
          9
        ]
      },
      {
        "segment": {
          "startIndex": 5098,
          "endIndex": 5191,
          "text": "日本建築学会編『雪と建築』（技報堂出版）コラム「雪の吸音効果」"
        },
        "groundingChunkIndices": [
          5
        ]
      },
      {
        "segment": {
          "startIndex": 5098,
          "endIndex": 5273,
          "text": "日本建築学会編『雪と建築』（技報堂出版）コラム「雪の吸音効果」、中谷宇吉郎 雪の科学館展示解説「雪と音、眠りについて」"
        },
        "groundingChunkIndices": [
          6
        ]
      },
      {
        "segment": {
          "startIndex": 5439,
          "endIndex": 5622,
          "text": "まるでクロード・モネの絵画『睡蓮』のように、錦鯉が宙に浮いているかのように見える関市板取の「名もなき池（通称：モネの池）」"
        },
        "groundingChunkIndices": [
          10,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 5733,
          "endIndex": 5865,
          "text": "水源である高賀山（こうかさん）の伏流水が極めて「貧栄養（ひんえいよう）」な湧水だからです"
        },
        "groundingChunkIndices": [
          10,
          12,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 5868,
          "endIndex": 6120,
          "text": "高賀山の山体が流紋岩（りゅうもんがん）類で構成されており、そこを通り抜けて湧き出る水には微生物やアオコ・藻類のエサとなる養分（リンや窒素など）がほとんど含まれていません"
        },
        "groundingChunkIndices": [
          12,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 6123,
          "endIndex": 6249,
          "text": "そのため、水を濁らせる微生物やプランクトンが繁殖できず、極限の透明度が保たれています"
        },
        "groundingChunkIndices": [
          14,
          12,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 6291,
          "endIndex": 6424,
          "text": "池の面積はテニスコートより少し大きい程度の**約400平方メートル**、最大水深は約0.5メートルです"
        },
        "groundingChunkIndices": [
          10
        ]
      },
      {
        "segment": {
          "startIndex": 6427,
          "endIndex": 6559,
          "text": "伏流水が常に湧き出しているため、池の水温は年間を通じて**約14℃**でほぼ一定に保たれています"
        },
        "groundingChunkIndices": [
          10,
          12,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 6562,
          "endIndex": 6688,
          "text": "そのため、冬でも水草（コウホネなど）が枯れにくく、冬枯れせずに鮮やかな景観が続きます"
        },
        "groundingChunkIndices": [
          10,
          12
        ]
      },
      {
        "segment": {
          "startIndex": 6715,
          "endIndex": 6877,
          "text": "この幻想的な景観は、行政や観光業者が巨費を投じて計画的に作ったものではなく、「偶然が重なってできた産物」です"
        },
        "groundingChunkIndices": [
          10,
          11,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6880,
          "endIndex": 7004,
          "text": "もともとは1980年頃に作られた農業用の貯水池（溜池）で、当時は雑草が生い茂っていました"
        },
        "groundingChunkIndices": [
          10,
          12,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 7007,
          "endIndex": 7215,
          "text": "1999年に近隣の花苗生産者が除草して睡蓮を植え、さらに近所の住民が自宅で飼えなくなった錦鯉を放したことで、現在の奇跡的な景観が偶然完成しました"
        },
        "groundingChunkIndices": [
          10,
          11,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 7245,
          "endIndex": 7371,
          "text": "地元では昔から「根道神社の池」や単に「池」と呼ばれており、正式名称はいまもありません"
        },
        "groundingChunkIndices": [
          10,
          12,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 7374,
          "endIndex": 7611,
          "text": "フランスのモネ財団による承認を得た公称ではないため、権利上の配慮から、岐阜県や関市の公式観光案内では一貫して「名もなき池（通称：モネの池）」と表記されています"
        },
        "groundingChunkIndices": [
          10,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 7641,
          "endIndex": 7749,
          "text": "関市観光協会観光情報、岐阜県観光連盟「名もなき池（通称：モネの池）」案内"
        },
        "groundingChunkIndices": [
          10,
          12
        ]
      },
      {
        "segment": {
          "startIndex": 7641,
          "endIndex": 7776,
          "text": "関市観光協会観光情報、岐阜県観光連盟「名もなき池（通称：モネの池）」案内、関市板取地域資料"
        },
        "groundingChunkIndices": [
          10,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 8200,
          "endIndex": 8287,
          "text": "「原料の繊維の長さ」と「酸性薬品を使わない製法」にあります"
        },
        "groundingChunkIndices": [
          16,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 8290,
          "endIndex": 8464,
          "text": "一般的な洋紙（木材パルプ紙）は短くすり潰した繊維を酸性の薬品等で固めて作るため「自己加水分解（酸性劣化）」が進みます"
        },
        "groundingChunkIndices": [
          16,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 8467,
          "endIndex": 8797,
          "text": "一方、美濃和紙は「楮（こうぞ）」の強靭で非常に長い植物繊維を傷つけずに使用し、灰汁（アルカリ性）で煮て不純物を除き、清流（長良川・板取川）に晒して漉くため中性〜弱アルカリ性に保たれ、繊維同士が強固に絡み合って劣化しません"
        },
        "groundingChunkIndices": [
          18,
          16,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 8839,
          "endIndex": 9039,
          "text": "奈良・東大寺の正倉院に収蔵されている日本最古の紙は、**大宝2年（702年）**の「美濃国戸籍用紙（加毛郡半布里／現在の富加町などの戸籍）」です"
        },
        "groundingChunkIndices": [
          18,
          19,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 9042,
          "endIndex": 9170,
          "text": "実に**1320年以上前**の紙ですが、漉きムラがなく破れもせず、当時の文字が黒々と残っています"
        },
        "groundingChunkIndices": [
          18,
          20
        ]
      },
      {
        "segment": {
          "startIndex": 9173,
          "endIndex": 9311,
          "text": "当時、朝廷へ納められた諸国の戸籍用紙のなかでも美濃国の紙が最も優秀であったと記録されています"
        },
        "groundingChunkIndices": [
          21,
          20
        ]
      },
      {
        "segment": {
          "startIndex": 9338,
          "endIndex": 9740,
          "text": "薄く漉かれているにもかかわらず引っ張っても破れない強靭さを持つため、現在ではルーブル美術館や大英博物館など世界の名だたる美術館で、レオナルド・ダ・ヴィンチのデッサンやレンブラントの版画といった「国宝級の西洋美術・文化財の修復用紙」として本美濃紙が指名・使用されています"
        },
        "groundingChunkIndices": [
          22
        ]
      },
      {
        "segment": {
          "startIndex": 9770,
          "endIndex": 9869,
          "text": "江戸時代には、幕府の御用障子紙として美濃の紙が最上と定められました"
        },
        "groundingChunkIndices": [
          18,
          20
        ]
      },
      {
        "segment": {
          "startIndex": 9872,
          "endIndex": 10073,
          "text": "その規格寸法が「美濃判（みのばん）」として全国の障子の基準サイズになり、当時は障子のこと自体を「みの」と呼ぶほど生活に定着していました"
        },
        "groundingChunkIndices": [
          23
        ]
      },
      {
        "segment": {
          "startIndex": 10103,
          "endIndex": 10158,
          "text": "文化庁 文化遺産オンライン「本美濃紙」"
        },
        "groundingChunkIndices": [
          20
        ]
      },
      {
        "segment": {
          "startIndex": 10103,
          "endIndex": 10242,
          "text": "文化庁 文化遺産オンライン「本美濃紙」、富加町「奈良正倉院に残る最古の戸籍（半布里戸籍）」資料"
        },
        "groundingChunkIndices": [
          19
        ]
      },
      {
        "segment": {
          "startIndex": 10103,
          "endIndex": 10281,
          "text": "文化庁 文化遺産オンライン「本美濃紙」、富加町「奈良正倉院に残る最古の戸籍（半布里戸籍）」資料、美濃和紙の里会館歴史資料"
        },
        "groundingChunkIndices": [
          21
        ]
      },
      {
        "segment": {
          "startIndex": 11069,
          "endIndex": 11174,
          "text": "「実はあの美しい錦鯉たち、観光用に計画して放流されたものではありません"
        },
        "groundingChunkIndices": [
          10,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 11177,
          "endIndex": 11418,
          "text": "1990年代の終わりに、近所の花苗屋さんが善意でスイレンを植えていたところ、近所の人たちが『家で飼えなくなっちゃったから』と鯉を池に持ち込んだのが始まりだったそうです"
        },
        "groundingChunkIndices": [
          10,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 11421,
          "endIndex": 11586,
          "text": "湧水が綺麗で微生物が少なく、鯉が元気に泳ぎ回ることで、まるでモネの睡蓮のような奇跡の風景が偶然生まれたんですね"
        },
        "groundingChunkIndices": [
          10,
          14,
          11
        ]
      }
    ],
    "webSearchQueries": [
      "雪が降ると静かになる 理由 吸音率 気象庁 科学",
