          "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEn_bH9MXUU5vHJxFiswqFxqCxHM6DDqU52xIagC3y9R2qjuLzz_rL-x5d1RJ5Trn7DMroXjiIxKiT8hs0XIb2cPZ3PNAyfmc8FfZjD0pXcgy7hW-gv",
          "title": "a-def.com"
        }
      }
    ],
    "groundingSupports": [
      {
        "segment": {
          "startIndex": 612,
          "endIndex": 739,
          "text": "名前に「シカ」と付きますが、生物学的にはシカ科ではなく**ウシ科（ヤギ亜科）**の動物です"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 762,
          "endIndex": 828,
          "text": "骨格や内臓の構造がウシやヤギと共通しています"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 831,
          "endIndex": 997,
          "text": "ウシと同じように4つの胃を持ち、一度飲み込んだ植物を口に戻して噛み直す「反芻（はんすう）」を行いながら消化します"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 1040,
          "endIndex": 1109,
          "text": "決定的な違いは「角（ツノ）」と「暮らし方」です"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1117,
          "endIndex": 1319,
          "text": "**本物のシカ（ニホンジカ）：** 角が生えるのは基本的に**オスのみ**で、木の枝のように枝分かれし、**毎年春にポロリと抜け落ちて生え替わります**"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1322,
          "endIndex": 1373,
          "text": "また、群れで行動することが多いです"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1381,
          "endIndex": 1522,
          "text": "**カモシカ：** **オスにもメスにも角があり**、枝分かれしない黒く鋭い角（長さ10〜15cmほど）が生えます"
        },
        "groundingChunkIndices": [
          2,
          3,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 1525,
          "endIndex": 1664,
          "text": "この角は中が骨で表面を角質が覆う「洞角（どうかく）」と呼ばれ、**一生抜け落ちずに伸び続けます**"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1667,
          "endIndex": 1746,
          "text": "群れは作らず、1頭ごとに縄張りを持って単独で行動します"
        },
        "groundingChunkIndices": [
          2,
          0,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 1749,
          "endIndex": 1799,
          "text": "体長は約1〜1.2m、体重30〜40kgほどです"
        },
        "groundingChunkIndices": [
          0,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 1827,
          "endIndex": 1990,
          "text": "すらりと細く美しい脚を「カモシカのような脚」と例えますが、実際のニホンカモシカの脚は**ずんぐりと太く短め**です"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1993,
          "endIndex": 2188,
          "text": "険しい岩場や急斜面を滑らずに踏ん張るための筋肉質な体型をしており、細い脚を持つ外国のレイヨウ（羚羊）と混同されたことによる誤解です"
        },
        "groundingChunkIndices": [
          4
        ]
      },
      {
        "segment": {
          "startIndex": 2237,
          "endIndex": 2417,
          "text": "明治から大正にかけて毛皮や肉目当てに乱獲され、大正時代には山奥にわずかに残るだけの「幻の動物」と呼ばれるまで激減しました"
        },
        "groundingChunkIndices": [
          5,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 2420,
          "endIndex": 2524,
          "text": "1934年に国の天然記念物、1955年に特別天然記念物に指定されて厳重に保護され"
        },
        "groundingChunkIndices": [
          1
        ]
      },
      {
        "segment": {
          "startIndex": 2420,
          "endIndex": 2647,
          "text": "1934年に国の天然記念物、1955年に特別天然記念物に指定されて厳重に保護され、現在では岐阜県内（飛騨市・高山市等）でも里山近くまで姿を見せるまでに回復しました"
        },
        "groundingChunkIndices": [
          0,
          6,
          4,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 2678,
          "endIndex": 2763,
          "text": "環境省 中部地方環境事務所「『カモシカ』はシカじゃない？」"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 2763,
          "endIndex": 2874,
          "text": "／飛騨市公式ウェブサイト「特別天然記念物『ニホンカモシカ』遭遇時は注意！」"
        },
        "groundingChunkIndices": [
          6
        ]
      },
      {
        "segment": {
          "startIndex": 2874,
          "endIndex": 2953,
          "text": "／富山市科学博物館「とやまサイエンストピックス No.543」"
        },
        "groundingChunkIndices": [
          1
        ]
      },
      {
        "segment": {
          "startIndex": 2874,
          "endIndex": 3023,
          "text": "／富山市科学博物館「とやまサイエンストピックス No.543」／みのかも文化の森 美濃加茂市民ミュージアム資料"
        },
        "groundingChunkIndices": [
          7
        ]
      },
      {
        "segment": {
          "startIndex": 3266,
          "endIndex": 3380,
          "text": "この冬の雷（冬季雷・とうきらい）は、夏の雷とは発生の仕組みも威力も桁違いです"
        },
        "groundingChunkIndices": [
          8,
          9,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 3403,
          "endIndex": 3566,
          "text": "夏の雷は強い日差しで地表が熱せられてできる背の高い積乱雲（雲頂10,000〜12,000m、雲の底は地上2,000mほど）で発生します"
        },
        "groundingChunkIndices": [
          9,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 3569,
          "endIndex": 3695,
          "text": "一方、冬の雷は大陸からの冷たい季節風が暖かい日本海を渡る際に水蒸気を含んで発生します"
        },
        "groundingChunkIndices": [
          8,
          12
        ]
      },
      {
        "segment": {
          "startIndex": 3698,
          "endIndex": 3863,
          "text": "冬の積乱雲は高さが3,000〜5,000m程度と低いのですが、**雲の底が地上数百メートルから1km以下と極めて低い位置**にあります"
        },
        "groundingChunkIndices": [
          9,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 3866,
          "endIndex": 3980,
          "text": "電気を帯びた層が地表に異常に近い位置にあるため、地上へ強烈な一撃が直撃します"
        },
        "groundingChunkIndices": [
          9,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4023,
          "endIndex": 4111,
          "text": "夏の雷は数多くピカピカと落ちますが、1回の放電時間は短めです"
        },
        "groundingChunkIndices": [
          8,
          12,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 4114,
          "endIndex": 4398,
          "text": "冬の雷は発生回数こそ少ないものの、1回あたりの放電継続時間が長く、大地に流れる電気エネルギー（電荷量）が**平均的な夏の雷の数十倍から数百倍**に達する超巨大落雷（モンスター落雷）が時折発生します"
        },
        "groundingChunkIndices": [
          8,
          9,
          12,
          14
        ]
      },
      {
        "segment": {
          "startIndex": 4426,
          "endIndex": 4652,
          "text": "冬の雷は雲から地上へ落ちるだけでなく、地上の高い鉄塔や山頂の避雷針から**空の雲に向かってイナズマが駆け上がる「上向き雷（上向き放電）」**が頻繁に起きます"
        },
        "groundingChunkIndices": [
          8,
          9
        ]
      },
      {
        "segment": {
          "startIndex": 4655,
          "endIndex": 4866,
          "text": "また、冬にこれほど雷が多発する地域は地球上でも極めて珍しく、**日本の日本海沿岸〜中部山岳地帯と、ノルウェー西岸など世界で数カ所**しかありません"
        },
        "groundingChunkIndices": [
          8
        ]
      },
      {
        "segment": {
          "startIndex": 4915,
          "endIndex": 5206,
          "text": "かつて日本の電力研究者が国際学会で「冬に巨大なエネルギーの雷が鳴り、地上から空へ雷が登る」と論文を発表した際、海外の学者からは「日本の学者がまた突飛な冗談を言っている」と信じてもらえませんでした"
        },
        "groundingChunkIndices": [
          9
        ]
      },
      {
        "segment": {
          "startIndex": 5209,
          "endIndex": 5439,
          "text": "しかし1990年代以降、日本海側に建設された欧州製の大型風力発電の風車（ブレード先端の高さ100m以上）が冬の雷で相次いで破壊され、その異常なパワーが実証されました"
        },
        "groundingChunkIndices": [
          9,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 5442,
          "endIndex": 5579,
          "text": "現在では国際大電力システム会議（CIGRE）などで世界中の技術者が注目する重要テーマになっています"
        },
        "groundingChunkIndices": [
          9
        ]
      },
      {
        "segment": {
          "startIndex": 5610,
          "endIndex": 5646,
          "text": "気象庁「冬季の雷」コラム"
        },
        "groundingChunkIndices": [
          10,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 5610,
          "endIndex": 5718,
          "text": "気象庁「冬季の雷」コラム／気象庁「あおぞら彩時記 2022年第4号（雷の特徴）」"
        },
        "groundingChunkIndices": [
          12
        ]
      },
      {
        "segment": {
          "startIndex": 5610,
          "endIndex": 5796,
          "text": "気象庁「冬季の雷」コラム／気象庁「あおぞら彩時記 2022年第4号（雷の特徴）」／電力中央研究所・株式会社サンコーシヤ雷情報技術資料"
        },
        "groundingChunkIndices": [
          8,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 5994,
          "endIndex": 6179,
          "text": "11月を過ぎると越冬穴に入って冬眠に入りますが、半年間も寝たきりで運動しないのに、なぜ春に目覚めてすぐ元気に動けるのでしょうか"
        },
        "groundingChunkIndices": [
          15,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 6202,
          "endIndex": 6405,
          "text": "通常、人間や実験動物はケガや病気でベッドに寝たきりになると、筋肉のタンパク質が分解されて1日あたり約0.5〜1.0%の割合で筋肉量が減っていきます"
        },
        "groundingChunkIndices": [
          17
        ]
      },
      {
        "segment": {
          "startIndex": 6408,
          "endIndex": 6815,
          "text": "しかしツキノワグマの骨格筋細胞は、冬眠期に入ると筋肉タンパク質の「合成」と「分解」の両方のシグナルを同時に強く抑え込む**「全身省エネモード」**へと切り替わり、筋肉が痩せ細るのを防いでいることが近年の研究で判明しました（広島大学・北海道大学・東京大学等の共同研究、2022年発表）"
        },
        "groundingChunkIndices": [
          15,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 6858,
          "endIndex": 6975,
          "text": "クマは冬眠中の**約5〜6か月間、水もエサも一滴も口にせず、尿も糞も一切出しません**"
        },
        "groundingChunkIndices": [
          15,
          18,
          19
        ]
      },
      {
        "segment": {
          "startIndex": 6978,
          "endIndex": 7273,
          "text": "人間なら数日で尿毒症になり、数週間で筋肉が激減して歩けなくなりますが、クマは冬眠期間を終えて巣穴から出た直後でも、**筋肉の線維の太さや遅筋・速筋の割合が活動期とほとんど変わらない状態**を保っています"
        },
        "groundingChunkIndices": [
          15,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 7379,
          "endIndex": 7458,
          "text": "という疑問の答えは、驚異の**「生体内リサイクル」**です"
        },
        "groundingChunkIndices": [
          19
        ]
      },
      {
        "segment": {
          "startIndex": 7461,
          "endIndex": 7723,
          "text": "筋肉の代謝から生じた老廃物（尿素）は膀胱などから再吸収され、腸内細菌の働きによって窒素へと分解され、なんと**新しいアミノ酸やタンパク質を作る原料として体内で再利用**されています"
        },
        "groundingChunkIndices": [
          20,
          19
        ]
      },
      {
        "segment": {
          "startIndex": 7964,
          "endIndex": 8159,
          "text": "しかしセンサーによる長期間観察や血液（血清）の詳細な分析により、完全に代謝レベルで筋肉分解がブロックされていることが証明されました"
        },
        "groundingChunkIndices": [
          15,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 8162,
          "endIndex": 8393,
          "text": "現在、冬眠クマの血清成分を応用して、高齢者の寝たきり（サルコペニア）防止や、長期宇宙飛行における宇宙飛行士の筋肉萎縮を防ぐ新薬の開発研究が進められています"
        },
        "groundingChunkIndices": [
          15,
          17,
          20,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 8424,
          "endIndex": 8683,
          "text": "東京大学大学院総合文化研究科／広島大学／北海道大学 プレスリリース「ツキノワグマは冬眠期に筋肉を省エネモードに変化させることで筋肉の衰えを防止していることを発見」（2022年11月）"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 8424,
          "endIndex": 8763,
          "text": "東京大学大学院総合文化研究科／広島大学／北海道大学 プレスリリース「ツキノワグマは冬眠期に筋肉を省エネモードに変化させることで筋肉の衰えを防止していることを発見」（2022年11月）／日本学術振興会 科研費研究成果報告（課題番号: 22H03439）"
        },
        "groundingChunkIndices": [
          18
        ]
      },
      {
        "segment": {
          "startIndex": 8889,
          "endIndex": 9006,
          "text": "晩秋から冬の朝、地面を踏むと「ザクザク」と心地よい音を立てる霜柱（しもばしら）"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 9009,
          "endIndex": 9123,
          "text": "実は、日本全国どこでも、あるいは寒い国ならどこでも見られる現象ではありません"
        },
        "groundingChunkIndices": [
          23,
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 9146,
          "endIndex": 9315,
          "text": "霜柱は、空気中の水蒸気が凍って草木や車のフロントガラスに付く「霜」とは別物で、**「土の中の水分」が凍ったもの**です"
        },
        "groundingChunkIndices": [
          23,
          24,
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 9318,
          "endIndex": 9443,
          "text": "地表の温度が0℃以下になり、かつ地中の温度が0℃以上のとき、地表付近の水がまず凍ります"
        },
        "groundingChunkIndices": [
          25,
          26,
          21
        ]
      },
      {
        "segment": {
          "startIndex": 9446,
          "endIndex": 9756,
          "text": "すると、まだ凍っていない地中の水分が、土の粒と粒の微細な隙間を通って**「毛細管現象（もうさいかんげんしょう）」**によって地表へ吸い上げられ、冷気に触れて次々と下から押し上げられながら凍ることで柱状に成長します"
        },
        "groundingChunkIndices": [
          23,
          25,
          27,
          21,
          28
        ]
      },
      {
        "segment": {
          "startIndex": 9799,
          "endIndex": 9933,
          "text": "霜柱は力持ちで、伸びるときに土や小石を持ち上げ、条件が良いと**10cm以上の高さ**まで成長します"
        },
        "groundingChunkIndices": [
          24,
          22,
          28
        ]
      },
      {
        "segment": {
          "startIndex": 9939,
          "endIndex": 10063,
          "text": "しかし、日本で最も寒い**北海道や、北陸などの豪雪地帯では霜柱はめったに見られません**"
        },
        "groundingChunkIndices": [
          21
        ]
      },
      {
        "segment": {
          "startIndex": 10066,
          "endIndex": 10219,
          "text": "雪が積もると、雪が天然の「断熱布団」になって冷気を遮断し、地表付近の土が氷点下まで冷え込まないためです"
        },
        "groundingChunkIndices": [
          23
        ]
      },
      {
        "segment": {
          "startIndex": 10247,
          "endIndex": 10434,
          "text": "土なら何でもいいわけではなく、適度な隙間を持つ**火山灰土（関東ローム層や軽石質の土など）**が最も霜柱を作りやすいとされています"
        },
        "groundingChunkIndices": [
          23,
          25,
          29
        ]
      },
      {
        "segment": {
          "startIndex": 10575,
          "endIndex": 10870,
          "text": "また、イギリスやドイツなどヨーロッパ諸国では霜柱は極めて珍しく、**「火山灰土が広く分布し、適度に冷え込み、雪が積もりすぎていない晴天の冬朝」**という条件が揃う日本は、世界でも稀に見る「霜柱大国」です"
        },
        "groundingChunkIndices": [
          23,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 11095,
          "endIndex": 11377,
          "text": "と驚愕し、イギリスを代表する科学雑誌『Nature』の投書欄に「日本で見られる奇妙な氷の柱」として相次いで報告・議論された記録が残っています（千葉大学・金光達太郎氏「霜柱の生長に関する研究」より）"
        },
        "groundingChunkIndices": [
          23
        ]
      },
      {
        "segment": {
          "startIndex": 11523,
          "endIndex": 11568,
          "text": "〜（千葉大学研究論文の解説）」"
        },
        "groundingChunkIndices": [
          23
        ]
      },
      {
        "segment": {
          "startIndex": 11622,
          "endIndex": 11682,
          "text": "冬の風物詩『霜柱』はどうやってできる？」"
        },
        "groundingChunkIndices": [
          28
        ]
      },
      {
        "segment": {
          "startIndex": 11682,
          "endIndex": 11743,
          "text": "／富山市科学博物館 科学普及資料「霜の話」"
        },
        "groundingChunkIndices": [
          24
        ]
      },
      {
        "segment": {
          "startIndex": 11832,
          "endIndex": 11928,
          "text": "国の特別天然記念物で、飛騨の山々でも時折出会う「ニホンカモシカ」"
        },
        "groundingChunkIndices": [
          6,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 11931,
          "endIndex": 12054,
          "text": "名前に「シカ」と付いていますが、実は生物学上はシカではなく「ウシ（牛）」の仲間です"
        },
        "groundingChunkIndices": [
          2,
          0,
          6
        ]
      },
      {
        "segment": {
          "startIndex": 12427,
          "endIndex": 12501,
          "text": "**① カモシカの角は一生生え替わらない（抜けない）**"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 12544,
          "endIndex": 12718,
          "text": "本物のシカ（ニホンジカ）の角は基本的にオスにしか生えず、毎年生え替わって春になると根元からポロリと自然に抜け落ちます"
        },
        "groundingChunkIndices": [
          2
        ]
      },
      {
        "segment": {
          "startIndex": 12721,
          "endIndex": 12863,
          "text": "一方、ウシ科であるカモシカは**オスにもメスにも角があり、一生抜けることなく少しずつ伸び続けます**"
        },
        "groundingChunkIndices": [
          2,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 12866,
          "endIndex": 13002,
          "text": "なお、カモシカもウシと同じ完全な草食動物で、胃もウシと同じようにしっかり「4つ」持っています"
        },
        "groundingChunkIndices": [
