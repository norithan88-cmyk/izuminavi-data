    "groundingSupports": [
      {
        "segment": {
          "startIndex": 531,
          "endIndex": 641,
          "text": "**理由：** 雪深い飛騨の冬は、山や庭の木々が葉を落とし、生花が手に入りません"
        },
        "groundingChunkIndices": [
          0,
          1
        ]
      },
      {
        "segment": {
          "startIndex": 644,
          "endIndex": 902,
          "text": "そこで、厳しい冬の家の中を少しでも明るく彩り、新しい年の「五穀豊穣（予祝儀礼）」や家族の無病息災を祈るために、枯れ枝に紅白のお餅を小さく巻きつけて花に見立てたのが始まりです"
        },
        "groundingChunkIndices": [
          1,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 908,
          "endIndex": 1255,
          "text": "**具体的な数字や比較：** 全国的にも「餅花（もちばな）」と呼ばれる風習はありますが、柳などの細い枝に丸めて付ける地域が多いのに対し、飛騨の「花もち」は自然の木の切り株や枝（ネジキやモミジなど）をそのまま土台に使う独特の力強さがあります"
        },
        "groundingChunkIndices": [
          3,
          4,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 1258,
          "endIndex": 1446,
          "text": "手のひらに乗る15センチ〜30センチほどの家庭用から、旅館や施設のエントランスに飾られる3メートル前後の巨大なものまで作られています"
        },
        "groundingChunkIndices": [
          1,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 1452,
          "endIndex": 1514,
          "text": "**意外な点：** お正月が終わっても捨てません"
        },
        "groundingChunkIndices": [
          1,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1517,
          "endIndex": 1716,
          "text": "ひな祭り（3月）の時期まで大切に飾り続け、最後は枝から外して油で揚げ、「雛あられ（かきもち）」として家族でおやつに美味しくいただきます"
        },
        "groundingChunkIndices": [
          1,
          2,
          3
        ]
      },
      {
        "segment": {
          "startIndex": 1719,
          "endIndex": 1803,
          "text": "冬の彩りから春の味わいへと移ろう、暮らしの循環の知恵です"
        },
        "groundingChunkIndices": [
          1,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1809,
          "endIndex": 1964,
          "text": "**歴史の裏話：** 江戸時代から始まったとされる花もちですが、明治時代までは壁に掛けるスタイルが一般的でした"
        },
        "groundingChunkIndices": [
          5
        ]
      },
      {
        "segment": {
          "startIndex": 1967,
          "endIndex": 2117,
          "text": "現在のように床の間や玄関にドッシリと置く「切り株仕立て」が主流になったのは、戦後の工夫によるものです"
        },
        "groundingChunkIndices": [
          5
        ]
      },
      {
        "segment": {
          "startIndex": 2120,
          "endIndex": 2231,
          "text": "自然木を使うため、水盤に挿しておくと春に木の芽が吹き出すこともあるそうです"
        },
        "groundingChunkIndices": [
          5
        ]
      },
      {
        "segment": {
          "startIndex": 2267,
          "endIndex": 2363,
          "text": "飛騨高山旅ガイド（高山市観光公式サイト）「お正月の装飾『花餅』」"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 2368,
          "endIndex": 2449,
          "text": "高山市役所広報「伝統の正月飾り『花もち』製作が最盛期」"
        },
        "groundingChunkIndices": [
          1
        ]
      },
      {
        "segment": {
          "startIndex": 2454,
          "endIndex": 2505,
          "text": "野外博物館「飛騨の里」民俗資料展示"
        },
        "groundingChunkIndices": [
          6
        ]
      },
      {
        "segment": {
          "startIndex": 2705,
          "endIndex": 2908,
          "text": "**理由：** 一般的な漆器は顔料を混ぜた黒漆や朱漆で木地を覆いますが、飛騨春慶は木目の美しさをそのまま見せる「透漆（すきうるし）」を使います"
        },
        "groundingChunkIndices": [
          7,
          8,
          9
        ]
      },
      {
        "segment": {
          "startIndex": 2911,
          "endIndex": 3121,
          "text": "天然の漆には、空気中の酸素や紫外線などの光に触れることで、年月の経過とともに漆自身の褐色が抜け、透明度が増していくという科学的性質があります"
        },
        "groundingChunkIndices": [
          10,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 3124,
          "endIndex": 3220,
          "text": "そのため、使い込むほど下地の木肌が黄金色に透き通って見えてきます"
        },
        "groundingChunkIndices": [
          7,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 3226,
          "endIndex": 3375,
          "text": "**具体的な数字や比較：** 多くの日用品は経年劣化で価値が下がりますが、春慶塗は「育てる器」と呼ばれます"
        },
        "groundingChunkIndices": [
          7,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 3378,
          "endIndex": 3627,
          "text": "材料には樹齢200年以上の天然ヒノキやサワラなどが使われ、木地職人がカンナで削り出した極上の木目が、5年、10年と使い込むにつれて飴色から明るい琥珀色へと表情を変えていきます"
        },
        "groundingChunkIndices": [
          7,
          8
        ]
      },
      {
        "segment": {
          "startIndex": 3633,
          "endIndex": 3797,
          "text": "**意外な点：** 飛騨春慶といえば高山のイメージが強いですが、ここ神岡町にも「神岡春慶」という独自の文化があります"
        },
        "groundingChunkIndices": [
          12
        ]
      },
      {
        "segment": {
          "startIndex": 3800,
          "endIndex": 4052,
          "text": "昭和初期に高山の名塗師を招いたことから始まり、重箱などの角物が多い高山に対して、神岡では丸盆やお椀など「丸い挽物（ひきもの）」を中心に受け継がれてきた歴史を持っています"
        },
        "groundingChunkIndices": [
          12
        ]
      },
      {
        "segment": {
          "startIndex": 4058,
          "endIndex": 4300,
          "text": "**歴史の裏話：** 慶長年間（約400年前）、高山城下の大工棟梁が偶然割ったサワラの木目の美しさに打たれ、作ったお盆を藩主の息子（茶人・金森宗和）に献上したのが始まりです"
        },
        "groundingChunkIndices": [
          7,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 4303,
          "endIndex": 4513,
          "text": "御用塗師が透明な漆で仕上げたところ、鎌倉時代の名陶「飛春慶（ひしゅんけい）」の茶入の美しい色艶に似ていたことから「春慶塗」と名付けられました"
        },
        "groundingChunkIndices": [
          7,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 4549,
          "endIndex": 4606,
          "text": "岐阜県伝統的工芸品指定資料「飛騨春慶」"
        },
        "groundingChunkIndices": [
          7,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 4611,
          "endIndex": 4687,
          "text": "岐阜女子大学 デジタルアーカイブ研究所「飛騨春慶塗」"
        },
        "groundingChunkIndices": [
          10
        ]
      },
      {
        "segment": {
          "startIndex": 4692,
          "endIndex": 4762,
          "text": "日本伝統文化振興機構（JTCO）「飛騨春慶」工芸解説"
        },
        "groundingChunkIndices": [
          8
        ]
      },
      {
        "segment": {
          "startIndex": 4899,
          "endIndex": 5021,
          "text": "**理由：** さるぼぼに顔がないのは、持つ人の心をそのまま映し出す「映し鏡」だからです"
        },
        "groundingChunkIndices": [
          14,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 5024,
          "endIndex": 5234,
          "text": "持ち主が嬉しいときには一緒に微笑んでいるように見え、悲しいときや辛いときには一緒に悲しんで寄り添ってくれるように、あえて表情を描いていません"
        },
        "groundingChunkIndices": [
          14,
          16,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 5237,
          "endIndex": 5378,
          "text": "また、持ち主に降りかかる災難を肩代わりしてくれる「身代わり人形」としての意味も込められています"
        },
        "groundingChunkIndices": [
          14,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 5384,
          "endIndex": 5657,
          "text": "**具体的な数字や比較：** さるぼぼの原型は、約1200年前（奈良時代）に中国から伝わり、平安貴族が出産の無事を祈って産屋に飾ったお守り人形「這子（ほうこ）」や「天児（あまがつ）」まで遡ります"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 5660,
          "endIndex": 5876,
          "text": "江戸時代になると庶民に広まり、飛騨の農家のおばあちゃんやお母さんが、端切れ布を使って子どもや孫のために手縫いする玩具兼お守りへと受け継がれました"
        },
        "groundingChunkIndices": [
          17,
          18,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 5882,
          "endIndex": 5998,
          "text": "**意外な点：** 「さるぼぼ」は飛騨弁で「猿の赤ん坊（ぼぼ＝赤ちゃん）」のことです"
        },
        "groundingChunkIndices": [
          19,
          16
        ]
      },
      {
        "segment": {
          "startIndex": 6001,
          "endIndex": 6220,
          "text": "猿は音読みで「エン」と読むため「良縁」「夫婦円満」、訓読みで「さる」と読むため「厄が去る」「病が去る」という、縁起の良い言葉遊びが重ねられています"
        },
        "groundingChunkIndices": [
          16,
          20,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6223,
          "endIndex": 6382,
          "text": "昭和中期にお土産物として全国に知られ始めた当初は、顔がないため「少し怖い」と誤解されたこともあったそうです"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6388,
          "endIndex": 6600,
          "text": "**歴史の裏話：** 全身が赤い布で作られているのは、江戸時代に最も恐れられていた感染症「天然痘（疱瘡）」の神様が赤色を嫌うと信じられていたためです"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6603,
          "endIndex": 6771,
          "text": "医療が未発達だった時代、赤ん坊が病気にかからず健康に育ってほしいという切実な親心が、この赤い姿に託されていました"
        },
        "groundingChunkIndices": [
          20,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6902,
          "endIndex": 6965,
          "text": "岐阜県郷土民芸資料「さるぼぼの歴史と這子」"
        },
        "groundingChunkIndices": [
          17,
          15
        ]
      },
      {
        "segment": {
          "startIndex": 7132,
          "endIndex": 7200,
          "text": "**理由：** 和ろうそくの芯の構造に秘密があります"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 7203,
          "endIndex": 7413,
          "text": "西洋ローソクが綿糸を編んだ芯を使うのに対し、和ろうそくは和紙にい草（灯芯）を巻きつけて作り、中心がストローのように中空（空洞）になっています"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 7416,
          "endIndex": 7659,
          "text": "火を灯すと、この空洞を通じて下から空気が自然に吸い上げられる（煙突効果）ため、風がまったく吹いていない室内でも、炎が自ら呼吸するように大きくゆらゆらと揺れるのです"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 7665,
          "endIndex": 7958,
          "text": "**具体的な数字や比較：** 一般的な西洋ローソクは石油由来のパラフィンですが、飛騨市古川町で240年以上続く老舗（三嶋和ろうそく店）の和ろうそくは、櫨（ハゼ）の実を絞った植物性油脂（木蝋）100％で作られます"
        },
        "groundingChunkIndices": [
          23,
          21,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 7961,
          "endIndex": 8215,
          "text": "職人が熱い蝋を手ですくい、芯に何度も掛け重ねて年輪のように太らせる「生掛け（きがけ）」という製法を守り続けており、朝4時から作業を始めても1日に作れるのはわずか150本ほどです"
        },
        "groundingChunkIndices": [
          21,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 8221,
          "endIndex": 8457,
          "text": "**意外な点：** 風もないのに炎がポンポンと生きているように揺れる様子を見て、飛騨の人々は昔から「仏様やご先祖様が喜んで微笑んでいる」と言い表し、親しんできました"
        },
        "groundingChunkIndices": [
          21,
          25
        ]
      },
      {
        "segment": {
          "startIndex": 8463,
          "endIndex": 8651,
          "text": "**歴史の裏話：** 植物性の木蝋と中空の芯のおかげで完全に燃焼しやすく、石油系ローソクに比べて黒い煙（油煙・煤）がほとんど出ません"
        },
        "groundingChunkIndices": [
          23,
          21,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 8654,
          "endIndex": 8885,
          "text": "飛騨地域には豪華な金箔を施した仏壇や立派なお寺の本堂が多いですが、その貴重な金箔や天井を煤で汚さないための、生活に根ざした優れた実用性の知恵でもありました"
        },
        "groundingChunkIndices": [
          21,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 8921,
          "endIndex": 8999,
          "text": "飛騨市公式観光サイト「飛騨の旅（三嶋和ろうそく店）」"
        },
        "groundingChunkIndices": [
          26
        ]
      },
      {
        "segment": {
          "startIndex": 9004,
          "endIndex": 9089,
          "text": "飛騨古川まつり会館 公式アーカイブ「飛騨の匠と和ろうそく」"
        },
        "groundingChunkIndices": [
          23
        ]
      },
      {
        "segment": {
          "startIndex": 9094,
          "endIndex": 9145,
          "text": "岐阜県観光連盟「三嶋和ろうそく店」"
        },
        "groundingChunkIndices": [
          27
        ]
      },
      {
        "segment": {
          "startIndex": 9283,
          "endIndex": 9352,
          "text": "雪深い飛騨の冬を明るく彩るお正月飾り「花もち」"
        },
        "groundingChunkIndices": [
          1,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 9355,
          "endIndex": 9562,
          "text": "木の枝に紅白のお餅を巻きつけて花に見立てたものですが、実はお正月が終わってもすぐには片付けず、春のある季節行事まで飾っておく風習があります"
        },
        "groundingChunkIndices": [
          1,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 9876,
          "endIndex": 9914,
          "text": "**② ひな祭り（桃の節句）**"
        },
        "groundingChunkIndices": [
          1,
          3,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 9957,
          "endIndex": 10105,
          "text": "飛騨では、お正月が終わってもそのまま床の間などに飾っておき、3月のひな祭りの時期まで目を楽しませます"
        },
        "groundingChunkIndices": [
          1,
          3,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 10108,
          "endIndex": 10288,
          "text": "乾燥してカチカチになったお餅を枝からポキポキと外し、油で揚げると、サクサクの香ばしい「雛あられ（かきもち）」に変身します"
        },
        "groundingChunkIndices": [
          1,
          3,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 10291,
          "endIndex": 10495,
          "text": "冬の花のない時期を慰めてくれたお飾りを、春の訪れとともに最後まで感謝して美味しくいただくという、飛騨の昔ながらの優しい暮らしの知恵ですね"
        },
        "groundingChunkIndices": [
          1,
          2,
          3
        ]
      }
    ],
