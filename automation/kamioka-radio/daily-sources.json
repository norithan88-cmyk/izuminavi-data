    "groundingSupports": [
      {
        "segment": {
          "startIndex": 953,
          "endIndex": 1139,
          "text": "住む場所や店を広げるため、川の斜面や擁壁の上に柱を立て、敷地を空中にせり出させて（オーバーハングさせて）建て増しを行いました"
        },
        "groundingChunkIndices": [
          0,
          1,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1181,
          "endIndex": 1390,
          "text": "昭和25年（1950年）に1町2村が合併して神岡町が誕生した際、町の人口は約2万4,000人を記録し、当時の岐阜県下の「町」として第一位の人口規模を誇りました"
        },
        "groundingChunkIndices": [
          3,
          4
        ]
      },
      {
        "segment": {
          "startIndex": 1393,
          "endIndex": 1465,
          "text": "ピーク時の昭和35年（1960年）前後には2万7,000人を超え"
        },
        "groundingChunkIndices": [
          3,
          5
        ]
      },
      {
        "segment": {
          "startIndex": 1393,
          "endIndex": 1552,
          "text": "ピーク時の昭和35年（1960年）前後には2万7,000人を超え、人口の多くが船津地区を中心とする狭い市街地に集中しました"
        },
        "groundingChunkIndices": [
          3
        ]
      },
      {
        "segment": {
          "startIndex": 1560,
          "endIndex": 1758,
          "text": "表の道路から見るとごく普通の平屋や2階建てに見える家が、川側（裏手）から見ると3階建て・4階建ての立体構造になっているのが大きな特徴です"
        },
        "groundingChunkIndices": [
          0,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1785,
          "endIndex": 1950,
          "text": "民家だけでなく、鉱山労働者たちで賑わった花街（旧花園町の遊郭建築など）や商店も川沿いにせり出して建てられました"
        },
        "groundingChunkIndices": [
          0,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 1953,
          "endIndex": 2052,
          "text": "土地がないからこそ生まれた、まるで水上に浮かぶ楼閣のような景観です"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 2082,
          "endIndex": 2213,
          "text": "最盛期の神岡は全国から鉱山関係者が集まり、町内には映画館が3〜4軒もひしめき合っていました"
        },
        "groundingChunkIndices": [
          3
        ]
      },
      {
        "segment": {
          "startIndex": 2216,
          "endIndex": 2441,
          "text": "激しい住宅需要の中で生まれたこの崖沿いの家屋群は、現在では「昭和の鉱都のエネルギーを今に伝える貴重な景観」として、建築ファンや散策客を惹きつけています"
        },
        "groundingChunkIndices": [
          0,
          2
        ]
      },
      {
        "segment": {
          "startIndex": 2473,
          "endIndex": 2546,
          "text": "飛騨市公式観光サイト「飛騨の旅」 神岡街歩きガイド"
        },
        "groundingChunkIndices": [
          6
        ]
      },
      {
        "segment": {
          "startIndex": 2553,
          "endIndex": 2659,
          "text": "岐阜県立森林文化アカデミー 地域資源報告（飛騨市神岡町の地形と町の形成）"
        },
        "groundingChunkIndices": [
          1
        ]
      },
      {
        "segment": {
          "startIndex": 2666,
          "endIndex": 2739,
          "text": "岐阜県・岐阜新聞「ぎふ140景 飛騨市神岡町の町並み」"
        },
        "groundingChunkIndices": [
          0
        ]
      },
      {
        "segment": {
          "startIndex": 2929,
          "endIndex": 2995,
          "text": "神岡の町を見下ろす高台に堂々と建つ「神岡城」"
        },
        "groundingChunkIndices": [
          7,
          8
        ]
      },
      {
        "segment": {
          "startIndex": 3139,
          "endIndex": 3410,
          "text": "戦国時代（永禄7年）に武田信玄の命で築かれた「東町城（ひがしまちじょう）」の城跡ですが、当時の城に天守閣屋舎はなく、江戸時代初期の一国一城令で取り壊されて石垣と堀だけになっていました"
        },
        "groundingChunkIndices": [
          9,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 3413,
          "endIndex": 3633,
          "text": "現在の立派な天守閣は、1970年（昭和45年）に神岡鉱山を運営していた**三井金属鉱業が神岡鉱業所の「創業100周年記念」として建設し、町に寄贈した模擬天守**です"
        },
        "groundingChunkIndices": [
          5,
          11,
          9,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 3675,
          "endIndex": 3827,
          "text": "三井組が神岡鉱山の蛇腹平坑などを取得した明治7年（1874年）から数えてちょうど100年目の節目に建設されました"
        },
        "groundingChunkIndices": [
          3,
          12,
          9
        ]
      },
      {
        "segment": {
          "startIndex": 3830,
          "endIndex": 3911,
          "text": "福井県の現存天守・丸岡城などをモデルに設計されています"
        },
        "groundingChunkIndices": [
          9,
          13
        ]
      },
      {
        "segment": {
          "startIndex": 3938,
          "endIndex": 4088,
          "text": "全国各地にあるお城の中でも、「民間鉱山会社が記念事業として建てた天守閣」というのは極めて珍しい例です"
        },
        "groundingChunkIndices": [
          11,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 4091,
          "endIndex": 4169,
          "text": "天守閣と同時に隣接して「鉱山資料館」も建てられました"
        },
        "groundingChunkIndices": [
          11,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 4199,
          "endIndex": 4345,
          "text": "神岡鉱山は明治以降の約130年間で約7,500万トンもの鉱石を採掘し、日本の近代化と高度経済成長を支えました"
        },
        "groundingChunkIndices": [
          8,
          11,
          12
        ]
      },
      {
        "segment": {
          "startIndex": 4348,
          "endIndex": 4513,
          "text": "神岡城は、日本を代表する企業城下町として町と鉱山が一体となって歩んできた歴史を象徴するモニュメントでもあります"
        },
        "groundingChunkIndices": [
          8,
          2,
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4545,
          "endIndex": 4632,
          "text": "飛騨市公式ウェブサイト「高原郷土館（神岡城・鉱山資料館）」"
        },
        "groundingChunkIndices": [
          7
        ]
      },
      {
        "segment": {
          "startIndex": 4639,
          "endIndex": 4708,
          "text": "岐阜県「ジオランドぎふ」鉱山資料館・神岡城解説"
        },
        "groundingChunkIndices": [
          11
        ]
      },
      {
        "segment": {
          "startIndex": 4715,
          "endIndex": 4760,
          "text": "三井金属鉱業「神岡鉱山の歴史」"
        },
        "groundingChunkIndices": [
          12,
          14
        ]
      },
      {
        "segment": {
          "startIndex": 5274,
          "endIndex": 5600,
          "text": "奈良時代の「養老律令（賦役令）」第39条に「斐陀国条」という特例が定められており、税を免除する代わりに、1里（50戸）ごとに10人の優れた大工・木工職人を都へ差し出す**「飛騨工（ひだのたくみ）制度」**が義務付けられていたためです"
        },
        "groundingChunkIndices": [
          15,
          16,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 5642,
          "endIndex": 5813,
          "text": "飛騨全体から毎年約100人の職人（世話係を含む）が交代で都へ派遣され、平城京や平安京の宮殿、大寺院の建築に従事しました"
        },
        "groundingChunkIndices": [
          16,
          18,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 5816,
          "endIndex": 5992,
          "text": "任期は1年間で、飛騨から都までは片道およそ14日（帰りは7日）をかけ、1年分の食糧（米）も飛騨の民衆が負担して都へ運びました"
        },
        "groundingChunkIndices": [
          16,
          18
        ]
      },
      {
        "segment": {
          "startIndex": 5995,
          "endIndex": 6120,
          "text": "平安末期までの約500年間に都へ出役した職人は延べ4万〜5万人にものぼると推計されています"
        },
        "groundingChunkIndices": [
          19
        ]
      },
      {
        "segment": {
          "startIndex": 6276,
          "endIndex": 6508,
          "text": "他国にはない卓越した木工技術を持っていたため、**「国税を棒引きにしてでも、職人集団として直属で徴発したかった」**という、中央政府の切実な要請による特例でした"
        },
        "groundingChunkIndices": [
          15,
          16,
          17
        ]
      },
      {
        "segment": {
          "startIndex": 6538,
          "endIndex": 6736,
          "text": "都で神業のような建築を次々と仕上げた飛騨の大工たちは評判を呼び、平安時代の説話集『今昔物語集』などにも伝説的な名工として描かれました"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 6739,
          "endIndex": 6925,
          "text": "この古代の技術集団が、のちに高山祭の精緻な屋台や各地の木工文化、ひいては飛騨の家具産業へと受け継がれていく源流となっています"
        },
        "groundingChunkIndices": [
          17,
          19
        ]
      },
      {
        "segment": {
          "startIndex": 6957,
          "endIndex": 7037,
          "text": "国税庁 税務大学校 租税史料「律令国家の免税（斐陀国）」"
        },
        "groundingChunkIndices": [
          15
        ]
      },
      {
        "segment": {
          "startIndex": 7044,
          "endIndex": 7160,
          "text": "文化庁 日本遺産ポータル「飛騨匠の技・こころ―木とともに、今に引き継ぐ1300年―」"
        },
        "groundingChunkIndices": [
          17,
          20
        ]
      },
      {
        "segment": {
          "startIndex": 7167,
          "endIndex": 7213,
          "text": "高山市史 街道編「飛騨工の登場」"
        },
        "groundingChunkIndices": [
          16
        ]
      },
      {
        "segment": {
          "startIndex": 7496,
          "endIndex": 7556,
          "text": "実は、岐阜県内を流れる飛騨川の河原でした"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 7577,
          "endIndex": 7898,
          "text": "昭和45年（1970年）、岐阜県加茂郡七宗（ひちそう）町の飛水峡（飛騨川河床）で採取された「上麻生礫岩（かみあそうれきがん）」を分析したところ、含まれていた珪線石片麻岩が**約20億年前**に形成されたものであることが判明しました"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 7940,
          "endIndex": 8086,
          "text": "日本列島そのものが大陸から離れて形作られたのは約数千万年前ですが、この岩石の年齢はなんと約20億年前"
        },
        "groundingChunkIndices": [
          21
        ]
      },
      {
        "segment": {
          "startIndex": 8089,
          "endIndex": 8154,
          "text": "地球誕生（約46億年前）の半分近く昔のものです"
        },
        "groundingChunkIndices": [
          23
        ]
      },
      {
        "segment": {
          "startIndex": 8157,
          "endIndex": 8244,
          "text": "発見当時、日本列島で最も古い岩石として日本中を驚かせました"
        },
        "groundingChunkIndices": [
          21,
          22
        ]
      },
      {
        "segment": {
          "startIndex": 8157,
          "endIndex": 8325,
          "text": "発見当時、日本列島で最も古い岩石として日本中を驚かせました（現地には町立「日本最古の石博物館」が建てられています"
        },
        "groundingChunkIndices": [
          23,
          24
        ]
      },
      {
        "segment": {
          "startIndex": 8355,
          "endIndex": 8435,
          "text": "足元の岩盤全体が20億年前のものだったわけではありません"
        },
        "groundingChunkIndices": [
          25
        ]
      },
      {
        "segment": {
          "startIndex": 8438,
          "endIndex": 8737,
          "text": "約1億数千万年前に河口などで固まった礫岩（砂利が固まった岩）のなかに、大陸から削られて流れ着いた「2〜3センチほどの小さな小石」として、20億年前の石がタイムカプセルのように奇跡的に閉じ込められていたのです"
        },
        "groundingChunkIndices": [
          21,
          25
        ]
      },
      {
        "segment": {
          "startIndex": 9195,
          "endIndex": 9261,
          "text": "岐阜県自然環境課「日本最古の石にふれるみち」"
        },
        "groundingChunkIndices": [
          21
        ]
      },
      {
        "segment": {
          "startIndex": 9268,
          "endIndex": 9334,
          "text": "七宗町公式ウェブサイト「日本最古の石博物館」"
        },
        "groundingChunkIndices": [
          23
        ]
      },
      {
        "segment": {
          "startIndex": 9341,
          "endIndex": 9410,
          "text": "岐阜県観光連盟「日本最古の石博物館」公式ガイド"
        },
        "groundingChunkIndices": [
          26
        ]
      },
      {
        "segment": {
          "startIndex": 9501,
          "endIndex": 9612,
          "text": "飛騨市神岡町の町並みを見下ろす高台に、かっこいい天守閣がそびえる「神岡城」"
        },
        "groundingChunkIndices": [
          7,
          9
        ]
      },
      {
        "segment": {
          "startIndex": 9615,
          "endIndex": 9780,
          "text": "実はこの天守閣、昭和45年（1970年）にある意外な理由で建てられたものなんですが、その理由とは次のうちどれでしょう？"
        },
        "groundingChunkIndices": [
          5,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 9880,
          "endIndex": 9988,
          "text": "**2番：** 神岡鉱山を運営していた三井金属鉱業が、創業100周年記念として建てた"
        },
        "groundingChunkIndices": [
          5,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 10103,
          "endIndex": 10191,
          "text": "**正解：** **2番（三井金属鉱業が創業100周年記念として建てた）**"
        },
        "groundingChunkIndices": [
          5,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 10221,
          "endIndex": 10332,
          "text": "「神岡城はもともと戦国時代、武田信玄の家来が築いた東町城というお城の跡です"
        },
        "groundingChunkIndices": [
          7,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 10335,
          "endIndex": 10437,
          "text": "しかし当時は天守閣などはなく、江戸時代のはじめに取り壊されていました"
        },
        "groundingChunkIndices": [
          9,
          10
        ]
      },
      {
        "segment": {
          "startIndex": 10443,
          "endIndex": 10638,
          "text": "今ある立派な天守閣は、明治7年に鉱山経営を始めた三井金属鉱業（神岡鉱業所）が、創業100周年を記念して昭和45年に町へ寄贈したものなんです"
        },
        "groundingChunkIndices": [
